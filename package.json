{
  "name": "dsh-smart-compact",
  "version": "0.1.8",
  "description": "Agent-requested context compaction at turn boundaries, with a per-session suggested threshold kept below the Harness' own compaction rail.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "policy.js",
    "routes.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/policy.test.mjs && node test/host.test.mjs && node test/routes.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggrgg13/dsh-smart-compact.git"
  },
  "homepage": "https://github.com/ggrgg13/dsh-smart-compact#readme",
  "bugs": {
    "url": "https://github.com/ggrgg13/dsh-smart-compact/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "compaction"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
